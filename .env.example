# Public site URL. Use your Vercel preview URL for testing, then your final custom domain.
SITE_URL=https://reads.tomocacoffee.et

# Supabase > Project Settings > API Keys / Connect
# Use the new server-only secret key (sb_secret_...). Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback is supported temporarily if your project has not created a secret key yet:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# First-admin activation token. Generate: openssl rand -hex 32
ADMIN_SETUP_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Optional extra secret mixed into login-rate-limit identifiers. Generate: openssl rand -hex 32
RATE_LIMIT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Vercel Cron bearer secret. Generate: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Stripe dashboard keys and recurring monthly Price ID
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# Optional operational tuning
RSS_MAX_BYTES=2097152
REGISTRATION_RETENTION_DAYS=365
OVERRIDE_RETENTION_DAYS=90
